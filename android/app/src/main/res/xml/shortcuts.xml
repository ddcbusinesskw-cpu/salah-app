<?xml version="1.0" encoding="utf-8"?>
<!-- اختصارات التطبيق (ضغطة مطوّلة على الأيقونة): المواقيت، القبلة، المصحف، التسبيح، التسميع.
     كل اختصار يفتح MainActivity مع extra noor_screen → الواجهة تنفّذ go(<screen>) (index.html: _wgRoute).
     أغلب المشغّلات تعرض ٤ اختصارات ثابتة فقط — الترتيب هنا هو ترتيب الأهمية. تُفعَّل بعد إضافة
     <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/> داخل <activity> في البيان (مقترح). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="times"
        android:enabled="true"
        android:icon="@drawable/ic_sc_times"
        android:shortcutShortLabel="@string/sc_times"
        android:shortcutLongLabel="@string/sc_times_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.ddcbusiness.noor"
            android:targetClass="com.ddcbusiness.noor.MainActivity">
            <extra android:name="noor_screen" android:value="times" />
        </intent>
