<?xml version="1.0" encoding="utf-8"?>
<!-- أداة ٤×٢: أعلى — الصلاة القادمة ووقتها + (الهجري · المدينة)؛ أسفل — الصلوات الخمس في صف (القادمة بالذهبي).
     النصوص والألوان تملؤها PrayerWidgetProvider؛ اتجاه التخطيط يُضبط برمجياً بحسب لغة الواجهة -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:layoutDirection="locale"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">
    <TextView
        android:id="@+id/wg_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9BA3C9"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_next_prayer" />
    <TextView
        android:id="@+id/wg_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#E3C88E"
        android:textSize="22sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="1dp"
        android:text="@string/widget_open_app" />
    <TextView
        android:id="@+id/wg_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9BA3C9"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        android:text="" />
    <LinearLayout
        android:id="@+id/wg_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/widget_cell_bg"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:id="@+id/wg_n0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9BA3C9"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/wg_t0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#EEF0FA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:layout_marginTop="1dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/widget_cell_bg"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:id="@+id/wg_n1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9BA3C9"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/wg_t1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#EEF0FA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:layout_marginTop="1dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/widget_cell_bg"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:id="@+id/wg_n2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9BA3C9"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/wg_t2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#EEF0FA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:layout_marginTop="1dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/widget_cell_bg"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:id="@+id/wg_n3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9BA3C9"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/wg_t3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#EEF0FA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:layout_marginTop="1dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/widget_cell_bg"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:id="@+id/wg_n4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9BA3C9"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/wg_t4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#EEF0FA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
