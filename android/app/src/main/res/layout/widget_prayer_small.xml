<?xml version="1.0" encoding="utf-8"?>
<!-- أداة ٢×١: الصلاة القادمة ووقتها + التاريخ الهجري. النصوص تملؤها PrayerWidgetProvider بلغة الواجهة؛
     اتجاه التخطيط يُضبط برمجياً (setLayoutDirection) بحسب اللغة -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:layoutDirection="locale"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">
    <TextView
        android:id="@+id/wg_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9BA3C9"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_next_prayer" />
    <TextView
        android:id="@+id/wg_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#E3C88E"
        android:textSize="19sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        android:text="@string/widget_open_app" />
    <TextView
        android:id="@+id/wg_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9BA3C9"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="3dp"
        android:text="" />
</LinearLayout>
