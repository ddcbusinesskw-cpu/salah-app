<?xml version="1.0" encoding="utf-8"?>
<!-- Al-Mujaddid adaptive icon. No <inset>: the foreground PNGs are drawn on the full
     108dp canvas with the word inside the 66dp safe circle, so an extra 16.7% inset
     would shrink the word a second time (to about 2/3 size). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
